cc_binary {
    name: "scandiumd",
    srcs: [
        "src/main.cpp",
        "src/ScandiumPerfd.cpp",
        "src/CpuTuner.cpp",
        "src/GpuTuner.cpp",
        "src/GpuSpoof.cpp",
        "src/MemoryTuner.cpp",
        "src/IoTuner.cpp",
        "src/ThermalMonitor.cpp",
        "src/GameDetector.cpp",
        "src/NetworkTuner.cpp",
        "src/SchedTuner.cpp",
        "src/DisplayTuner.cpp",
        "src/KernelTuner.cpp",
        "src/FsOptimizer.cpp",
        "src/InterruptBalancer.cpp",
        "src/LmkTuner.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libcutils",
        "libutils",
    ],
    local_include_dirs: ["include"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-DLOG_TAG=\"scandiumd\"",
    ],
    cpp_std: "c++17",
    init_rc: ["scandiumd.rc"],
    vendor: true,
}
